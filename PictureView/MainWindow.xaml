<Window x:Class="PictureView.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PictureView"
        xmlns:selector="clr-namespace:PictureView.TemplateSelector"
        xmlns:vm="clr-namespace:PictureView.ViewModels"
        mc:Ignorable="d"
        Title="Media Viewer" Height="450" Width="800" Icon="pack://application:,,,/PictureView;component/app-icon.png">

   
    <Window.Resources>
        <DataTemplate x:Key="ExplorerTabTemplate" DataType="{x:Type vm:ExplorerTabViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TreeView ItemsSource="{Binding ExplorerTree}"/>
                <ListView Grid.Column="1" ItemsSource="{Binding ExplorerFiles}">

                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ExplorerFileViewModel}">
                            <StackPanel>
                                <Image Source="{Binding Icon}" Width="64" Height="64"/>
                                <TextBlock Text="{Binding Name}" TextAlignment="Center"/>
                                <Button Content="Open" Command="{Binding OpenCommand}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </DataTemplate>
        <!-- Template pour l’onglet Image -->
        <DataTemplate x:Key="ImageTabTemplate" DataType="{x:Type vm:ImageTabViewModel}">
            <Image Source="{Binding Image}" Stretch="Uniform"/>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <DockPanel LastChildFill="True">
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="File">
                 <MenuItem Header="Open" Command="{Binding OpenCommand}"></MenuItem>
                <MenuItem Header="Recent File"></MenuItem>
                    <MenuItem Header="Browse" Command="{Binding BrowseCommand}" />
                    <MenuItem Header="Close"></MenuItem>
                <MenuItem Header="Close all"></MenuItem>
                <Separator></Separator>
                <MenuItem Header="Save"></MenuItem>
                <MenuItem Header="Save As"></MenuItem>
                <Separator></Separator>
                <MenuItem Header="Print"></MenuItem>
                <Separator></Separator>
                <MenuItem Header="Quit" Command="{Binding Path=QuitCommand}"></MenuItem>
            </MenuItem>
            <MenuItem Header="Edition">
                <MenuItem Header="Cut"></MenuItem>
                <MenuItem Header="Copy"></MenuItem>
                <MenuItem Header="Paste"></MenuItem>
                <MenuItem Header="Delete"></MenuItem>
                <MenuItem Header="Rename"></MenuItem>
            </MenuItem>
            <MenuItem Header="View">
                <MenuItem Header="Full screen"></MenuItem>
                <MenuItem Header="Real size"></MenuItem>
                <MenuItem Header="Adjust">
                    <MenuItem Header="No Adjustment"></MenuItem>
                    <MenuItem Header="Adjust to the size of the window"></MenuItem>
                    <MenuItem Header="Adjust to the width of the window"></MenuItem>
                </MenuItem>
                <Separator>
                </Separator>
                <MenuItem Header="Zoom +"></MenuItem>
                <MenuItem Header="Zoom -"></MenuItem>
                <MenuItem Header="File">
                    <MenuItem Header="Next File"></MenuItem>
                    <MenuItem Header="Previous File"></MenuItem>
                    <MenuItem Header="Last One"></MenuItem>
                    <MenuItem Header="First One"></MenuItem>
                </MenuItem>
                <MenuItem Header="Display Tabs"></MenuItem>
                <MenuItem Header="Display Tool bar"></MenuItem>
                <MenuItem Header="Display State bar"></MenuItem>
            </MenuItem>
            <MenuItem Header="Image">
                <MenuItem Header="Number of used colors"></MenuItem>
                <MenuItem Header="Rotate">
                    <MenuItem Header="90° clock wise"></MenuItem>
                    <MenuItem Header="90° reverse clock wise"></MenuItem>
                    <MenuItem Header="180°"></MenuItem>
                </MenuItem>
                <MenuItem Header="Mirror">
                    <MenuItem Header="Vertical"></MenuItem>
                    <MenuItem Header="Horizontal"></MenuItem>
                </MenuItem>
                <MenuItem Header="Resize"></MenuItem>
                <MenuItem Header="Correct red eyes"></MenuItem>
            </MenuItem>
            <MenuItem Header="Tools">
                <MenuItem Header="Find a file"></MenuItem>
                <MenuItem Header="Hexadecimal display"></MenuItem>
                <MenuItem Header="Diaporama"></MenuItem>
                <MenuItem Header="Send by email"></MenuItem>
                <MenuItem Header="Parameters"></MenuItem>
                <MenuItem Header="Slide show"></MenuItem>
                <Separator></Separator>
                <MenuItem Header="Place the selected pictures on the screen"></MenuItem>                
            </MenuItem>
            <MenuItem Header="Window">
                <MenuItem Header="Tile"></MenuItem>
                <MenuItem Header="Tile Horizontally"></MenuItem>
                <MenuItem Header="Tile Vertically"></MenuItem>
                <MenuItem Header="Minimize all"></MenuItem>
                <MenuItem Header="Restore all"></MenuItem>
            </MenuItem>
            <MenuItem Header="Info">
                <MenuItem Header="Help"></MenuItem>
            </MenuItem>
            
        </Menu>

            <TabControl ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}">
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}" />
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplateSelector>
                    <selector:TabContentTemplateSelector
         ExplorerTemplate="{StaticResource ExplorerTabTemplate}"
         ImageTemplate="{StaticResource ImageTabTemplate}" />
                </TabControl.ContentTemplateSelector>
            </TabControl>
        </DockPanel>
    </Grid>
</Window>
